---
import { site, theme } from "../lib/config";
import { pluginUrl } from "../lib/cdn";
import { t } from "../lib/i18n";

const use = String(theme.comments?.use || "")
  .split(/[/,]/)
  .map((s) => s.trim())
  .filter(Boolean);
const twikooOn = use.includes("Twikoo") && Boolean(theme.twikoo?.envId);
const title = theme.comments?.title || t("comment");
const envId = String(theme.twikoo?.envId || "").replace(/\/+$/, "");
const region = theme.twikoo?.region || "";
const src = theme.twikoo?.src || pluginUrl("twikoo");
const integrity = theme.twikoo?.integrity || "";
const lang = site.language || "zh-CN";
---

{
  twikooOn && (
    <section id="post-comment">
      <div class="comment-head">
        <div class="comment-headline">
          <i class="anzhiyufont anzhiyu-icon-comments" />
          <span>{title}</span>
        </div>
      </div>
      <div id="twikoo-wrap">
        <div id="twikoo" class="twikoo-comment" />
      </div>
      <script
        is:inline
        define:vars={{ envId, region, src, integrity, lang }}
      >
        (() => {
          const loadTwikoo = () =>
            new Promise((resolve, reject) => {
              if (window.twikoo) {
                resolve();
                return;
              }
              const existing = document.querySelector(`script[src="${src}"]`);
              if (existing) {
                if (existing.dataset.loaded === "true" || window.twikoo) {
                  existing.dataset.loaded = "true";
                  resolve();
                  return;
                }
                existing.addEventListener("load", () => {
                  existing.dataset.loaded = "true";
                  resolve();
                }, { once: true });
                existing.addEventListener("error", reject, { once: true });
                return;
              }
              const script = document.createElement("script");
              script.src = src;
              if (integrity) {
                script.integrity = integrity;
                script.crossOrigin = "anonymous";
              }
              script.dataset.loaded = "false";
              script.addEventListener("load", () => {
                script.dataset.loaded = "true";
                resolve();
              }, { once: true });
              script.addEventListener("error", reject, { once: true });
              document.head.appendChild(script);
            });

          let initPromise;
          const initTwikoo = () => {
            const el = document.getElementById("twikoo");
            if (!el || el.dataset.initialized === "true") return;
            if (initPromise) return;
            initPromise = loadTwikoo()
              .then(() => {
                if (!window.twikoo || !document.body.contains(el)) {
                  throw new Error("Twikoo 客户端脚本加载后未找到 window.twikoo");
                }
                const twikoo = window.twikoo;
                const init =
                  typeof twikoo === "function"
                    ? twikoo
                    : typeof twikoo.init === "function"
                      ? twikoo.init.bind(twikoo)
                      : typeof twikoo.default === "function"
                        ? twikoo.default
                        : undefined;
                if (!init) {
                  throw new Error("当前 Twikoo 客户端没有导出 init 方法");
                }
                init({
                  envId,
                  el: "#twikoo",
                  lang,
                  ...(region ? { region } : {}),
                });
                el.dataset.initialized = "true";
              })
              .catch((error) => {
                initPromise = undefined;
                console.error("Twikoo 初始化失败，请检查 comments.use、twikoo.envId 以及评论服务端配置。", error);
              });
          };

          const initWhenReady = () => {
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", initTwikoo, { once: true });
            } else {
              initTwikoo();
            }
          };

          initWhenReady();
          window.addEventListener("pageshow", initTwikoo);
          document.addEventListener("astro:page-load", initTwikoo);
        })();
      </script>
    </section>
  )
}
