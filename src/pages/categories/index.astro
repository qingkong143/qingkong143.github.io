---
import Layout from "../../layouts/Layout.astro";
import { categoryPath, getAllCategories, getPosts } from "../../lib/posts";
import { t } from "../../lib/i18n";

const posts = await getPosts();
const cats = getAllCategories(posts);
---

<Layout pageType="page" pageTitle={t("page.category")} posts={posts}>
  <div id="page">
    <div id="tag">
      <div class="category-lists" id="tag-page-tags">
        {
          cats.map(([name, list]) => (
            <a href={categoryPath(name)} id={categoryPath(name)}>
              <span class="tags-punctuation">#</span>
              {name}
              <span class="tagsPageCount">{list.length}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
