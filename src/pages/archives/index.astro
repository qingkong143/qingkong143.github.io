---
import Layout from "../../layouts/Layout.astro";
import ArticleSort from "../../components/ArticleSort.astro";
import { getPosts } from "../../lib/posts";
import { t } from "../../lib/i18n";

const posts = await getPosts();
---

<Layout pageType="page" pageTitle={t("page.archives")} posts={posts}>
  <div id="archive">
    <div class="article-sort-title">{t("page.articles")} - {posts.length}</div>
    <ArticleSort posts={posts} />
  </div>
</Layout>
