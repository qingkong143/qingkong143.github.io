---
import Layout from "../layouts/Layout.astro";
import Comments from "../components/Comments.astro";
import { getCollection, render } from "astro:content";
import { getPosts } from "../lib/posts";
import { t } from "../lib/i18n";

const posts = await getPosts();
const aboutItems = await getCollection("about");
const about = aboutItems[0];
const { Content } = about ? await render(about) : { Content: null };
const pageTitle = about?.data.title || t("about.title");
---

<Layout pageType="page" pageTitle={pageTitle} posts={posts}>
  <div id="page">
    <h1 class="page-title">{pageTitle}</h1>
    <hr class="post-divider" />
    <article id="article-container" class="post-content page-content">
      {Content && <Content />}
    </article>
  </div>
  <Comments />
</Layout>
